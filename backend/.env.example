# ============================================================================
# ELI — Variables de entorno (plantilla)
# ============================================================================
# Copia este archivo a `.env` y rellena los valores.
#
#   cp backend/.env.example backend/.env
#
# Todas las variables usan el prefijo ELI_ (configurable en settings.py).
# Las vacías son opcionales salvo las marcadas como [REQUERIDA].
# ============================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ELI_ENV=dev
ELI_LOG_LEVEL=INFO
ELI_TRACE_ENABLED=true

# ---------------------------------------------------------------------------
# Base de datos [REQUERIDA]
# ---------------------------------------------------------------------------
# El user/password/db por defecto coinciden con infra/docker-compose.yml.
ELI_DATABASE_URL=postgresql+asyncpg://eli:eli@localhost:5432/eli

# ---------------------------------------------------------------------------
# LLM — proveedor por defecto y cadena de fallback
# ---------------------------------------------------------------------------
# Elige el proveedor activo. Debe existir en la cadena de fallback.
#   openai | groq | mistral | openrouter | gemini | ollama | fake
ELI_LLM_PROVIDER=openai

# Cadena ordenada de proveedores si el principal falla.
ELI_LLM_FALLBACK_CHAIN=groq,mistral,openrouter,gemini,ollama

# Modelo por defecto (STANDARD) y profundo (DEEP).
ELI_LLM_DEFAULT_MODEL=openai/gpt-oss-120b
ELI_LLM_DEEP_MODEL=openai/gpt-oss-120b

# Timeout por request al LLM (segundos).
ELI_LLM_REQUEST_TIMEOUT_S=120

# ---------------------------------------------------------------------------
# API keys por proveedor (rellena solo las que uses)
# ---------------------------------------------------------------------------

# Groq (compatible OpenAI, endpoint por defecto)
ELI_OPENAI_API_KEY=
ELI_OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Mistral
ELI_MISTRAL_API_KEY=
ELI_MISTRAL_BASE_URL=https://api.mistral.ai/v1
ELI_MISTRAL_MODEL=ministral-3b-2512

# OpenRouter
ELI_OPENROUTER_API_KEY=
ELI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ELI_OPENROUTER_MODEL=openrouter/free

# Google Gemini (chat + embeddings + Vision OCR de imágenes)
ELI_GEMINI_API_KEY=
ELI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ELI_GEMINI_MODEL=gemini-3.5-flash-lite
ELI_GEMINI_EMBEDDINGS_MODEL=gemini-embedding-001

# Ollama (LLM local, último fallback)
ELI_OLLAMA_BASE_URL=http://localhost:11434
ELI_OLLAMA_CHAT_MODEL=qwen2.5:3b
ELI_OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text

# Cerebras (opcional)
ELI_CEREBRAS_API_KEY=
ELI_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
ELI_CEREBRAS_MODEL=qwen-3.8-27b

# SambaNova (opcional)
ELI_SAMBANOVA_API_KEY=
ELI_SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
ELI_SAMBANOVA_MODEL=gpt-oss-120b

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# chain = usa la cadena automática con fallback.
ELI_EMBEDDINGS_PROVIDER=chain

# Cohere (embeddings)
ELI_COHERE_API_KEY=

# Jina (embeddings)
ELI_JINA_API_KEY=
ELI_JINA_MODEL=jina-embeddings-v3

# Voyage (embeddings)
ELI_VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------

# Tavily (necesaria para web_search)
ELI_TAVILY_API_KEY=

# YouTube Data API v3 (necesaria para youtube_search)
ELI_YOUTUBE_API_KEY=

# Límites de web_fetch
ELI_WEB_FETCH_TIMEOUT_S=15
ELI_WEB_FETCH_MAX_BYTES=500000

# ---------------------------------------------------------------------------
# Presupuestos de tokens / contexto
# ---------------------------------------------------------------------------
ELI_MAX_CONTEXT_TOKENS=16000
ELI_MAX_RESPONSE_TOKENS=1024
ELI_HISTORY_RECENT_MESSAGES=20
ELI_MAX_TOOL_CALLS=4
ELI_MAX_UPLOAD_SIZE_MB=25

# ---------------------------------------------------------------------------
# Memoria
# ---------------------------------------------------------------------------
ELI_MEMORY_ENABLED=true
ELI_MEMORY_EXTRACTION_ENABLED=true
ELI_MEMORY_TOKEN_BUDGET=600
ELI_MEMORY_TOP_K=5

# ---------------------------------------------------------------------------
# RAG
# ---------------------------------------------------------------------------
ELI_RAG_ENABLED=true
ELI_RAG_TOP_K=6
ELI_RAG_TOKEN_BUDGET=1500
ELI_RAG_MAX_CHUNKS_PER_DOC=500
ELI_INGESTION_ENABLED=true

# ---------------------------------------------------------------------------
# Razonamiento (planificación + resúmenes)
# ---------------------------------------------------------------------------
ELI_PLANNING_ENABLED=true
ELI_PLANNING_MAX_STEPS=6
ELI_PLANNING_STEP_MAX_TOKENS=800
ELI_PLANNING_FINAL_CONTEXT_CHARS=8000

ELI_SUMMARIZATION_ENABLED=true
ELI_SUMMARIZATION_THRESHOLD=40
ELI_SUMMARIZATION_KEEP_RECENT=20

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# [REQUERIDA en producción] Clave para firmar sesiones. Genera una aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
ELI_SECRET_KEY=cambia-esto-en-produccion-con-algo-seguro

# Cookie de sesión
# - domain: vacío en dev. `.tudominio.com` en prod con subdominios.
# - secure: true en prod (requiere HTTPS), false en dev con HTTP.
ELI_COOKIE_DOMAIN=
ELI_COOKIE_SAMESITE=lax
ELI_COOKIE_SECURE=false
ELI_SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Google OAuth (opcional)
# ---------------------------------------------------------------------------
# Crea credenciales en https://console.cloud.google.com/apis/credentials
ELI_GOOGLE_CLIENT_ID=
ELI_GOOGLE_CLIENT_SECRET=
ELI_GOOGLE_REDIRECT_URI=
ELI_OAUTH_REDIRECT_AFTER_LOGIN=/