ELI_ENV=dev
ELI_LOG_LEVEL=INFO

# BD principal
ELI_DATABASE_URL=postgresql+asyncpg://eli:eli@localhost:5432/eli

# Proveedor LLM: "fake" (por defecto, sin API key) u "openai"
ELI_LLM_PROVIDER=fake
ELI_LLM_DEFAULT_MODEL=gpt-4o-mini
ELI_LLM_DEEP_MODEL=gpt-4o
ELI_OPENAI_API_KEY=

# Presupuestos
ELI_MAX_CONTEXT_TOKENS=16000
ELI_MAX_RESPONSE_TOKENS=1024
ELI_HISTORY_RECENT_MESSAGES=20

# Observabilidad
ELI_TRACE_ENABLED=true